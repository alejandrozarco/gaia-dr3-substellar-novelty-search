# %ECSV 1.0
# ---
# datatype:
# - name: GaiaEDR3
#   datatype: int64
#   description: Unique source identifier (unique within a particular Data Release)
#   meta: !!omap
#   - {ucd: meta.id}
# - {name: src, datatype: string}
# - {name: ra_1, datatype: float64}
# - {name: dec_1, datatype: float64}
# - {name: simbad, datatype: string}
# - {name: otype, datatype: string}
# - {name: nref, datatype: int64}
# - {name: vsx, datatype: string}
# - {name: RK, datatype: string}
# - {name: Downes, datatype: string}
# - {name: Rodriguez25, datatype: bool}
# - {name: Liu25, datatype: bool}
# - {name: GEM26, datatype: bool}
# - {name: in4XMM, datatype: bool}
# - {name: in2RXS, datatype: bool}
# - {name: in_eRASS1, datatype: bool}
# - {name: GaiaVclass, datatype: string}
# - {name: known_cv, datatype: bool}
# - name: ra_2
#   unit: deg
#   datatype: float64
#   description: Right ascension
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {utype: 'stc:AstroCoords.Position3D.Value3.C1'}
# - name: dec_2
#   unit: deg
#   datatype: float64
#   description: Declination
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {utype: 'stc:AstroCoords.Position3D.Value3.C2'}
# - name: parallax
#   unit: mas
#   datatype: float64
#   description: Parallax
#   meta: !!omap
#   - {ucd: pos.parallax.trig}
# - name: parallax_error
#   unit: mas
#   datatype: float32
#   description: Standard error of parallax
#   meta: !!omap
#   - {ucd: stat.error;pos.parallax.trig}
# - name: ruwe
#   datatype: float32
#   description: Renormalised unit weight error
#   meta: !!omap
#   - {ucd: stat.error}
# - name: phot_g_mean_mag
#   unit: mag
#   datatype: float32
#   description: G-band mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt}
# - name: bp_rp
#   unit: mag
#   datatype: float32
#   description: BP - RP colour
#   meta: !!omap
#   - {ucd: phot.color;em.opt.B;em.opt.R}
# - name: phot_variable_flag
#   datatype: string
#   description: Photometric variability flag
#   meta: !!omap
#   - {ucd: meta.code;src.var}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: non_single_star
#   datatype: int16
#   description: Flag indicating the availability of additional information in the various Non-Single Star tables
#   meta: !!omap
#   - {ucd: meta.code.status}
# - name: has_xp_continuous
#   datatype: bool
#   description: Flag indicating the availability of mean BP/RP spectrum in continuous representation for this source
#   meta: !!omap
#   - {ucd: meta.code.status}
# - name: phot_bp_rp_excess_factor
#   datatype: float32
#   description: BP/RP excess factor
#   meta: !!omap
#   - {ucd: arith.factor;phot.flux;em.opt}
# - name: phot_g_n_obs
#   datatype: int16
#   description: Number of observations contributing to G photometry
#   meta: !!omap
#   - {ucd: meta.number}
# - name: phot_g_mean_flux_over_error
#   datatype: float32
#   description: G-band mean flux divided by its error
#   meta: !!omap
#   - {ucd: stat.snr;phot.flux;em.opt}
# - name: r_med_geo
#   unit: pc
#   datatype: float32
#   description: The median of the geometric distance posterior. The geometric distance estimate.
#   meta: !!omap
#   - {ucd: pos.distance}
# - name: r_lo_geo
#   unit: pc
#   datatype: float32
#   description: The 16th percentile of the geometric distance posterior. The lower 1-sigma-like bound on the confidence interval.
#   meta: !!omap
#   - {ucd: pos.distance;stat.min}
# - name: r_hi_geo
#   unit: pc
#   datatype: float32
#   description: The 84th percentile of the geometric distance posterior. The upper 1-sigma-like bound on the confidence interval.
#   meta: !!omap
#   - {ucd: pos.distance;stat.max}
# - {name: Fx, datatype: float64}
# - {name: e_Fx, datatype: float64}
# - {name: DetLike0, datatype: float64}
# - {name: pany, datatype: float64}
# - {name: sepX, datatype: float64}
# - {name: posErr, datatype: float64}
# - {name: FlagOpt, datatype: int64}
# - {name: Lx, datatype: float64}
# - {name: logFxFopt, datatype: float64}
# - {name: ebr, datatype: float64}
# - {name: MG0, datatype: float64}
# - {name: Lbol, datatype: float64}
# - {name: logLxLbol, datatype: float64}
# - {name: Jmag, datatype: float64}
# - {name: Hmag, datatype: float64}
# - {name: Kmag, datatype: float64}
# - {name: W1mag, datatype: float64}
# - {name: W2mag, datatype: float64}
# - {name: W3mag, datatype: float64}
# - name: G_J
#   unit: mag
#   datatype: float64
#   description: G-band mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt}
# - name: G_W1
#   unit: mag
#   datatype: float64
#   description: G-band mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt}
# - {name: J_H, datatype: float64}
# - {name: W1_W2, datatype: float64}
# - {name: vari, datatype: string}
# - {name: Ha_idx, datatype: float64}
# - {name: e_Ha_idx, datatype: float64}
# schema: astropy-2.0
GaiaEDR3 src ra_1 dec_1 simbad otype nref vsx RK Downes Rodriguez25 Liu25 GEM26 in4XMM in2RXS in_eRASS1 GaiaVclass known_cv ra_2 dec_2 parallax parallax_error ruwe phot_g_mean_mag bp_rp phot_variable_flag non_single_star has_xp_continuous phot_bp_rp_excess_factor phot_g_n_obs phot_g_mean_flux_over_error r_med_geo r_lo_geo r_hi_geo Fx e_Fx DetLike0 pany sepX posErr FlagOpt Lx logFxFopt ebr MG0 Lbol logLxLbol Jmag Hmag Kmag W1mag W2mag W3mag G_J G_W1 J_H W1_W2 vari Ha_idx e_Ha_idx
